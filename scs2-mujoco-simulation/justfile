set shell := ["bash", "-cu"]

# Build the Docker image used for the install/wrap steps.
docker:
    docker build -t ihmcrobotics/scs2-mujoco-simulation:0.1 .

# Stage MuJoCo SDK (headers + libmujoco.so) into build/ and resources/
install:
    docker run \
        --rm \
        --user $(id -u):$(id -g) \
        --volume $(pwd):/home/robotlab/scs2-mujoco-simulation \
        --workdir /home/robotlab/scs2-mujoco-simulation \
        ihmcrobotics/scs2-mujoco-simulation:0.1 bash install.sh

# Stage the Windows MuJoCo SDK (headers + mujoco.lib + mujoco.dll).
install-windows:
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./install.ps1

# Run JavaCPP to generate Mujoco.java and libjniMujoco.so. Requires `just install` first.
wrap:
    docker run \
        --rm \
        --user $(id -u):$(id -g) \
        --volume $(pwd):/home/robotlab/scs2-mujoco-simulation \
        --workdir /home/robotlab/scs2-mujoco-simulation \
        ihmcrobotics/scs2-mujoco-simulation:0.1 bash wrap.sh

# Run JavaCPP to generate Mujoco.java and jniMujoco.dll. Requires `just install-windows` first.
wrap-windows:
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./wrap.ps1

# Clear the local install and build artifacts (does not touch the Java side).
clear:
    rm -rf build install
